<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>CS324</groupId><artifactId>grpc-leader-election</artifactId><version>1.0-SNAPSHOT</version></parent>
    <artifactId>cluster-integration-tests</artifactId>
    <dependencies>
        <dependency><groupId>CS324</groupId><artifactId>cluster-shared</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>CS324</groupId><artifactId>cluster-bootstrap</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>CS324</groupId><artifactId>cluster-worker</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>CS324</groupId><artifactId>cluster-client</artifactId><version>${project.version}</version></dependency>
    </dependencies>
    <build>
        <plugins>
            <!--
                All tests live here, while the classes they exercise live in the sibling
                modules. report-aggregate turns the one jacoco.exec produced by this module
                into a coverage report over the shared/bootstrap/worker/client artifacts.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals><goal>report-aggregate</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
